<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Greedy Game</title>
  <script src="/socket.io/socket.io.js"></script>
  <style>
    body { font-family: Arial, sans-serif; text-align: center; background: #121212; color: #fff; margin: 0; padding: 20px; }
    #coins { font-size: 22px; color: #4caf50; font-weight: bold; margin-bottom: 10px; }
    #timer { font-size: 24px; color: #ffeb3b; font-weight: bold; margin-bottom: 20px; }
    .grid { display: grid; grid-template-columns: repeat(4, 1fr); max-width: 420px; gap: 10px; margin: 0 auto; }
    .box { background: #222; border: 2px solid #444; border-radius: 8px; padding: 15px 5px; cursor: pointer; }
    .box:hover { border-color: #ff9800; background: #333; }
    .box span { font-size: 26px; display: block; margin-bottom: 5px; }
    #status { margin-top: 20px; font-size: 16px; color: #bbb; min-height: 24px; }
  </style>
</head>
<body>
  <h2>Greedy Game Live</h2>
  <!-- यहाँ यूजर को 1000 कॉइन दिखेंगे -->
  <div id="coins">सिक्के: <span id="coinCount">1000</span></div>
  <div id="timer">लोड हो रहा है...</div>

  <div class="grid">
    <div class="box" onclick="placeBet(1)"><span>🍎</span>1. सेब</div>
    <div class="box" onclick="placeBet(2)"><span>🍊</span>2. संतरा</div>
    <div class="box" onclick="placeBet(3)"><span>🍌</span>3. केला</div>
    <div class="box" onclick="placeBet(4)"><span>🍇</span>4. अंगूर</div>
    <div class="box" onclick="placeBet(5)"><span>🍉</span>5. तरबूज</div>
    <div class="box" onclick="placeBet(6)"><span>🚗</span>6. कार</div>
    <div class="box" onclick="placeBet(7)"><span>⭐</span>7. स्टार</div>
    <div class="box" onclick="placeBet(8)"><span>👑</span>8. क्राउन</div>
  </div>

  <div id="status">दांव लगाने के लिए किसी भी बॉक्स पर क्लिक करें।</div>

  <script>
    const socket = io();
    // जावास्क्रिप्ट में भी 1000 कॉइन सेट कर दिए हैं
    let coins = 1000;
    let currentState = "BETTING";

    socket.on("timerUpdate", (data) => {
      currentState = data.gameState;
      const stateLabel = data.gameState === "BETTING" ? "दांव लगाएं" : "रिजल्ट समय";
      document.getElementById("timer").innerText = `समय: ${data.timeLeft}s (${stateLabel})`;
    });

    socket.on("gameResult", (data) => {
      document.getElementById("status").innerText = `🎉 राउंड खत्म! विजेता नंबर: ${data.winner}`;
    });

    function placeBet(spot) {
      if (currentState !== "BETTING") {
        alert("बेटिंग बंद है! अगले राउंड का इंतज़ार करें।");
        return;
      }
      if (coins < 10) {
        alert("सिक्के खत्म हो गए!");
        return;
      }
      coins -= 10;
      document.getElementById("coinCount").innerText = coins;
      document.getElementById("status").innerText = `आपने नंबर ${spot} पर 10 सिक्के लगाए!`;
    }
  </script>
</body>
</html>
